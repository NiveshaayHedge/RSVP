# ---- PostgreSQL (required) ----
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_DATABASE=
DB_SCHEMA=rvsp
# DB_SSL=require              # "require" (default) or "disable" for a local Postgres without TLS
# DB_SSL_CA=global-bundle.pem  # optional CA bundle (path relative to this file) for full certificate verification

# ---- Admin page (required) ----
ADMIN_PASSWORD=          # password for /admin
SESSION_SECRET=          # at least 32 random chars, e.g. `openssl rand -hex 32`
# SESSION_HOURS=12       # how long an admin sign-in lasts

# ---- Server (optional) ----
# PORT=3000
# TRUST_PROXY=true       # set when running behind nginx / a load balancer
# COOKIE_SECURE=true     # set when the site is served over HTTPS
